      }
    },
    {
      "name": "Перевести меню",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/venues/{{venue_id}}/menus/{{menu_id}}/translate/",
        "body": {

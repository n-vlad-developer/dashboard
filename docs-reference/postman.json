{
  "info": {
    "name": "Q1 dashboard v7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.mindtech.kz/api/dashboard"
    },
    {
      "key": "venue_id",
      "value": "2"
    },
    {
      "key": "object_id",
      "value": "1"
    },
    {
      "key": "menu_id",
      "value": "1"
    },
    {
      "key": "job_id",
      "value": "1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "updated_at",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": "replace-with-unique-key"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Вход",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login/",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const t=pm.response.json(); pm.collectionVariables.set(\"access\",t.access); pm.collectionVariables.set(\"refresh\",t.refresh); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Обновить access",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/refresh/",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"access\",pm.response.json().access);"
            ]
          }
        }
      ]
    },
    {
      "name": "Выход",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/logout/",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "Профиль и права",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/me/"
      }
    },
    {
      "name": "Список menus",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/venues/{{venue_id}}/menus/"
      }
    },
    {
      "name": "Объект menus",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/venues/{{venue_id}}/menus/{{object_id}}/"
      }
    },
    {
      "name": "Выключить menus",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "If-Match",
            "value": "{{updated_at}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/venues/{{venue_id}}/menus/{{object_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        }
      }
    },
    {
